<Window
    x:Class="ClamDown.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClamDown">
    <Grid Background="#10151D" Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="ClamDown" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Keep your work running. Keep your hardware safe."
                           Foreground="#9EADBE" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#263342" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="SERVICE CONTROL" Foreground="#B8C8D9" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#1A2633" CornerRadius="14" Padding="18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="Protection session" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SessionStatus" Text="Checking ClamDown Service…"
                               Foreground="#A9B8C8" FontSize="12"/>
                </StackPanel>
                <Button x:Name="SessionButton" Grid.Column="1" Content="Start 60-minute session"
                        VerticalAlignment="Center" Click="SessionButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="14" ColumnSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1A2633" CornerRadius="12" Padding="16">
                <StackPanel Spacing="7">
                    <TextBlock Text="CPU temperature" Foreground="#A9B8C8"/>
                    <TextBlock x:Name="CpuValue" Text="—" FontSize="28" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="Sensor telemetry" Foreground="#7F91A5" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#1A2633" CornerRadius="12" Padding="16">
                <StackPanel Spacing="7">
                    <TextBlock Text="GPU temperature" Foreground="#A9B8C8"/>
                    <TextBlock x:Name="GpuValue" Text="—" FontSize="28" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="NVIDIA / supported GPU" Foreground="#7F91A5" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#1A2633" CornerRadius="12" Padding="16">
                <StackPanel Spacing="7">
                    <TextBlock Text="Battery" Foreground="#A9B8C8"/>
                    <TextBlock x:Name="BatteryValue" Text="—" FontSize="28" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PowerValue" Text="Power state unavailable" Foreground="#7F91A5" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#1A2633" CornerRadius="12" Padding="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Hardware sensors" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProviderValue" Text="Initializing sensor provider…" Foreground="#91A3B7" FontSize="12"/>
                    </StackPanel>
                    <StackPanel x:Name="SensorList" Grid.Row="1" Spacing="8">
                        <TextBlock Text="Waiting for sensor readings…" Foreground="#A9B8C8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterStatus" Grid.Row="3"
                   Text="Keep-awake sessions are capped at 4 hours. Thermal cutoffs, fan control, and lid-policy overrides are not implemented; OEM safety controls remain authoritative."
                   Foreground="#91A3B7" TextWrapping="Wrap" FontSize="11"/>
    </Grid>
</Window>
